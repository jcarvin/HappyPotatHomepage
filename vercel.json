{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/.well-known/oauth-authorization-server"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ]
}
