{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/oauth/well-known"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ]
}
